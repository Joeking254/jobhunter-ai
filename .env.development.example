APP_ENV=development
APP_NAME=JOBHUNTER AI
SECRET_KEY=replace-with-a-random-development-secret
LOG_LEVEL=INFO
MYSQL_DATABASE=jobhunter_db
MYSQL_USER=jobhunter_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
VITE_API_BASE_URL=/api
COOKIE_SECURE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@jobhunter.local
SMTP_USE_TLS=true
