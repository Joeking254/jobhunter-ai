APP_ENV=production
APP_NAME=JOBHUNTER AI
SECRET_KEY=replace-with-a-long-random-secret-from-your-secret-manager
LOG_LEVEL=INFO
MYSQL_DATABASE=jobhunter_db
MYSQL_USER=jobhunter_app
MYSQL_PASSWORD=replace-with-a-unique-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-unique-strong-root-password
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
VITE_API_BASE_URL=/api
COOKIE_SECURE=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@jobhunter.local
SMTP_USE_TLS=true
